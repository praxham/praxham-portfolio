{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/files/resume/PrathamPatankarResume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename="PrathamPatankarResume.pdf""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    }
  ],
  "rewrites": [
